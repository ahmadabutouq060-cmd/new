rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ══ Model ═══════════════════════════════════════════════════════════════
       Everything a weaver owns lives under users/{uid}. Nothing here grants a
       read to anyone but the owner, so there is no leaderboard, no public thread
       state, and no way for one account to observe another.

       This file is server-authoritative. A browser may do exactly two things to
       its own Firestore data:

         · read it
         · write users/{uid}/mysteries/{id} — branch choices and local state
         · merge { wishlist, updatedAt } onto users/{uid}

       Everything else — creating the account, the reward ledger, completed
       waypoints, found secrets, the athar balance, badges and redemptions — is
       written by Cloud Functions and nobody else. The rules here say `if false`
       for those paths, and functions/index.js is what actually performs them.

       The reason is that this document is the product. `athar` is derived by the
       app from a base, the reward ledger and the spend log, so a client able to
       write any one of those three inputs controls its own balance. Guarding
       them with clever predicates has already failed once on this project:

       `growsOnly('atharBase')` asserted only that a new value was >= the old
       one. Monotonicity is not a cap — a single write of atharBase: 999999 was
       legal, every write after it was legal, and the floor in data.js then pinned
       that balance on every device for that account permanently, with no ledger
       entry contradicting it. A `false` cannot be argued with. Admin SDK writes
       bypass security rules entirely, so refusing the client costs the server
       nothing. */

    /* ── Primitives ───────────────────────────────────────────────────────── */

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /* Firestore has one integer type, but a JSON number can arrive as a float.
       `floor` is the only rounding in the rules language, so it stands in for
       Number.isInteger; it also rejects NaN, because NaN == NaN is false. */
    function isWhole(n) {
      return n is int || (n is float && floor(n) == n);
    }

    function isCount(n) {
      return isWhole(n) && n >= 0;
    }

    /* Timestamps are client wall clocks in ms, written by every save. */
    function isStamp(n) {
      return n is int && n > 0;
    }

    function isNullableText(n) {
      return n == null || (n is string && n.size() <= 64);
    }

    /* ── Mystery documents ───────────────────────────────────────────────────
       The one collection the client owns, so it is the one document shape the
       rules still have to police. A branch choice is the weaver's own reading
       of a text; athar is not, and is pinned below.

       Declared here at the top level on purpose: the rules language does not
       accept a function definition inside a match block, and `mysteryId` is a
       wildcard bound inside one, so it is passed in rather than captured. */
    function mysteryShapeOk(mysteryId) {
      /* The null check has to come before anything reads request.resource. On a
         delete it is null, and binding `let d = request.resource.data` above the
         guard raises an evaluation error instead of returning false — which is
         why the shape test lives in its own function. */
      return request.resource != null && mysteryFieldsOk(request.resource.data, mysteryId);
    }

    function mysteryFieldsOk(d, mysteryId) {
      return d.keys().hasOnly([
               'threadId', 'choices', 'currentChapter', 'clues', 'completed',
               'progressPercent', 'athar', 'reveal', 'updatedAt'
             ])
        && mysteryId.matches('^[0-9]+$')
        && d.threadId is int && d.threadId > 0
        && (d.currentChapter == null || d.currentChapter is string)
        && d.choices is map
        && d.clues is list
        && d.completed is list
        && isCount(d.progressPercent) && d.progressPercent <= 100
        && isCount(d.athar)
        && d.reveal is bool
        && isStamp(d.updatedAt);
    }

    /* ══ The weaver's own document ═══════════════════════════════════════════ */
    match /users/{uid} {

      allow read: if isOwner(uid);

      /* The client cannot create or delete this document.

         Creating it is initializeAccount's job — auth.js calls that callable the
         moment an account attaches, which is the only reason sign-in works at
         all under this rule. That callable takes identity and nothing else: the
         numbers on this document are the server's to mint. */
      allow create, delete: if false;

      /* A merge touching only wishlist and updatedAt. This is syncAccount()'s
         entire remaining write, and it is why a sign-in still persists anything.

         `hasOnly` is the whole guard: diff() reports every key that changed, so
         a merge that also moved athar, badges or redemptions fails on the set
         membership rather than on any predicate about the values. The hasAny
         below names those four fields explicitly, which is redundant today and
         deliberate — if someone widens hasOnly to admit, say, displayName, the
         sensitive ones still cannot slip through the second condition. */
      allow update: if isOwner(uid)
        && request.resource != null && resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wishlist', 'updatedAt'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'athar', 'atharPeak', 'atharBase', 'badges', 'redemptions'
           ]);

      /* ── The reward ledger ──────────────────────────────────────────────────
         Server-authoritative. Cloud Functions write it in a transaction that
         reads the document first, so the document id doubling as the unique key
         is what makes a payout idempotent: a refresh, a double tap and a second
         device collide on one create instead of paying three times.

         A client that could write a reward could also name its own amount, which
         is why the price lives in functions/lib/schema.js and the answer is
         checked in functions/lib/validation.js — neither of which a browser can
         reach. */
      match /rewards/{rewardId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      /* ── Progress ───────────────────────────────────────────────────────────
         Server-authoritative. completeWaypoint derives the document id
         (`t{thread}_w{waypoint}` or `t{thread}_progress`) and the completedAt
         stamp, so a client cannot un-complete a waypoint by rewriting a row, and
         cannot claim one it never reached. */
      match /progress/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      /* ── Mysteries ────────────────────────────────────────────────────────── */
      match /mysteries/{mysteryId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid) && mysteryShapeOk(mysteryId);

        allow update: if isOwner(uid)
          && mysteryShapeOk(mysteryId)
          && request.resource.data.threadId == resource.data.get('threadId', null)
          && request.resource.data.athar == resource.data.get('athar', 0);

        allow delete: if false;
      }

      /* ── Secrets ────────────────────────────────────────────────────────────
         Server-authoritative. The document records that a weaver found a hidden
         stop, so a client able to write it could claim any secret in the product
         without finding it. completeSecret checks the answer against its own
         table first. */
      match /secrets/{secretId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    /* ══ Legacy ═══════════════════════════════════════════════════════════════
       An earlier build stored the whole progress snapshot in one weavers/{uid}
       document. js/auth.js reads it once, on the first sign-in of an account with
       nothing under users/{uid}, and then never writes it again — so the write
       half is closed here. Leaving it open would keep a second, unvalidated path
       into the same data alive for no benefit. */
    match /weavers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
